{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Pavement Cost Projection timeline with Version 2 (reads from Power BI fields: Task, Phase, Start, Finish, Milestone, FinishDate, ColorKey, Version, Owner)",
  "width": 720,
  "height": {"step": 22},
  "data": {"name": "dataset"},
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadius": 2, "height": 13},
      "encoding": {
        "y": {
          "field": "Task", "type": "nominal", "sort": {"field": "Start"}, "title": null,
          "axis": {"labelLimit": 280, "labelFontSize": 10.5}
        },
        "x": {"field": "Start", "type": "temporal", "title": "Date", "axis": {"format": "%b %Y"}},
        "x2": {"field": "FinishDate"},
        "opacity": {
          "field": "Version", "type": "nominal",
          "scale": {"domain": ["Version 1", "Version 2"], "range": [1, 0.85]},
          "legend": null
        },
        "color": {
          "field": "ColorKey", "type": "nominal",
          "sort": ["1. Data Validation", "Buffer", "2. Cost Integration", "3. Model Refinement",
                   "4. Power BI Build", "5. Review & Rollout", "6. Version 2: Bid Item Analysis", "Milestone"],
          "scale": {
            "domain": ["1. Data Validation", "Buffer", "2. Cost Integration", "3. Model Refinement",
                       "4. Power BI Build", "5. Review & Rollout", "6. Version 2: Bid Item Analysis", "Milestone"],
            "range": ["#2F6FA6", "#9AA2AA", "#B4482F", "#C98A2A", "#3F8F5F", "#6B5B95", "#0F7C8C", "#1C2126"]
          },
          "legend": {"title": "Phase", "orient": "bottom", "columns": 4, "labelLimit": 220}
        },
        "tooltip": [
          {"field": "Task", "type": "nominal"},
          {"field": "Phase", "type": "nominal"},
          {"field": "Version", "type": "nominal"},
          {"field": "Owner", "type": "nominal"},
          {"field": "Start", "type": "temporal", "format": "%b %d, %Y"},
          {"field": "Finish", "type": "temporal", "format": "%b %d, %Y"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum['Version'] == 'Version 2'"},
        {"aggregate": [{"op": "min", "field": "Start", "as": "V2Start"}]}
      ],
      "layer": [
        {
          "mark": {"type": "rule", "color": "#0F7C8C", "strokeDash": [6, 4], "strokeWidth": 1.5},
          "encoding": {"x": {"field": "V2Start", "type": "temporal"}}
        },
        {
          "mark": {"type": "text", "align": "left", "baseline": "top", "dx": 4, "dy": 2, "color": "#0F7C8C", "fontWeight": "bold", "fontSize": 11},
          "encoding": {"x": {"field": "V2Start", "type": "temporal"}, "y": {"value": 0}, "text": {"value": "Version 2"}}
        }
      ]
    },
    {
      "transform": [{"aggregate": [{"op": "count", "as": "n"}]}, {"calculate": "now()", "as": "Today"}],
      "mark": {"type": "rule", "color": "#B4482F", "strokeDash": [2, 3], "strokeWidth": 1.5},
      "encoding": {"x": {"field": "Today", "type": "temporal"}}
    }
  ],
  "config": {
    "axis": {"grid": true, "gridColor": "#E1DFDD", "domainColor": "#D8D3C8"},
    "view": {"stroke": null},
    "font": "Segoe UI"
  }
}
