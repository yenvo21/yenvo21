{
  "name": "Bid Report Modern",
  "dataColors": ["#12239E", "#118DFF", "#E66C37", "#6B007B", "#8C96E0", "#E044A7", "#744EC2", "#D9B300"],
  "foreground": "#252B37",
  "foregroundNeutralSecondary": "#5B6170",
  "foregroundNeutralTertiary": "#6B7180",
  "background": "#FFFFFF",
  "backgroundLight": "#F6F7F9",
  "backgroundNeutral": "#E3E5EA",
  "tableAccent": "#12239E",
  "good": "#107C10",
  "neutral": "#D9B300",
  "bad": "#A4262C",
  "maximum": "#12239E",
  "center": "#8C96E0",
  "minimum": "#E8EBFA",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#252B37" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#252B37" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#252B37" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#252B37" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F5F8" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F5F8" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E5EA" } }, "radius": 12 }],
        "dropShadow": [{ "show": true, "preset": "Custom", "position": "Outer", "color": { "solid": { "color": "#101828" } }, "transparency": 92, "shadowBlur": 6, "shadowDistance": 1, "shadowSpread": 0, "angle": 90 }],
        "padding": [{ "top": 12, "bottom": 12, "left": 14, "right": 14 }],
        "title": [{ "fontFamily": "Segoe UI Semibold", "fontSize": 12, "fontColor": { "solid": { "color": "#252B37" } } }],
        "visualHeader": [{ "show": true, "transparency": 100 }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "header": [{ "show": true, "fontFamily": "Segoe UI Semibold", "textSize": 9, "fontColor": { "solid": { "color": "#5B6170" } }, "outline": "None" }],
        "items": [{ "fontFamily": "Segoe UI", "textSize": 10, "fontColor": { "solid": { "color": "#252B37" } }, "background": { "solid": { "color": "#FFFFFF" } }, "outline": "None" }],
        "selection": [{ "selectAllCheckboxEnabled": false, "singleSelect": false }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "fontFamily": "Segoe UI Semibold", "fontSize": 24, "color": { "solid": { "color": "#252B37" } } }],
        "categoryLabels": [{ "fontFamily": "Segoe UI", "fontSize": 10, "color": { "solid": { "color": "#5B6170" } } }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#EEF0F4" } }, "outlineColor": { "solid": { "color": "#D9DCE3" } } }],
        "columnHeaders": [{ "fontFamily": "Segoe UI Semibold", "fontColor": { "solid": { "color": "#5B6170" } }, "backColor": { "solid": { "color": "#FFFFFF" } } }],
        "values": [{ "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#FFFFFF" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#EEF0F4" } } }],
        "columnHeaders": [{ "fontFamily": "Segoe UI Semibold", "fontColor": { "solid": { "color": "#5B6170" } }, "backColor": { "solid": { "color": "#FFFFFF" } } }]
      }
    }
  }
}
